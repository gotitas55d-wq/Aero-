// ANIMACIÃ“N DE FONDO DE LA PORTADA
(function initCoverCanvas(){
  const canvas = document.getElementById('coverBgCanvas');
  const ctx = canvas.getContext('2d');
  let w, h;
  
  function resize(){
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  let angle = 0;
  function draw(){
    ctx.clearRect(0, 0, w, h);
    
    // Grid sutil radar
    ctx.strokeStyle = 'rgba(74, 242, 255, 0.08)';
    ctx.lineWidth = 1;
    let size = 40;
    for(let x = 0; x < w; x += size){
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
    }
    for(let y = 0; y < h; y += size){
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
    }

    // CÃ­rculos concÃ©ntricos de radar central
    let cx = w / 2, cy = h / 2;
    for(let r = 50; r < Math.max(w, h); r += 120){
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(74, 242, 255, 0.05)';
      ctx.stroke();
    }

    // Barrido rotativo
    angle += 0.01;
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(angle);
    let grad = ctx.createRadialGradient(0,0,10, 0,0, Math.max(w,h)/1.5);
    grad.addColorStop(0, 'rgba(74, 242, 255, 0.15)');
    grad.addColorStop(1, 'rgba(74, 242, 255, 0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.moveTo(0,0);
    ctx.arc(0,0, Math.max(w,h)/1.5, 0, Math.PI / 4);
    ctx.fill();
    ctx.restore();

    requestAnimationFrame(draw);
  }
  draw();
})();

