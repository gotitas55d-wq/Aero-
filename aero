function beep(f,d){if(!sOn)return;if(f>=800&&f<=1300&&!enRadar)return;let ac=ensureAudio();try{let o=ac.createOscillator(),g=ac.createGain();o.frequency.value=f;o.connect(g);g.connect(ac.destination);g.gain.setValueAtTime(0.25,ac.currentTime);g.gain.exponentialRampToValueAtTime(0.01,ac.currentTime+d);o.start();o.stop(ac.currentTime+d)}catch(e){}}

let noiseNode = null;
function playStatic(start){
  let ac = ensureAudio();
  if(start){
    if(noiseNode) return;
    let bufferSize = ac.sampleRate * 2,
        buffer = ac.createBuffer(1, bufferSize, ac.sampleRate),
        output = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) { output[i] = Math.random() * 2 - 1; }
    noiseNode = ac.createBufferSource();
    noiseNode.buffer = buffer;
    noiseNode.loop = true;
    let gain = ac.createGain();
    gain.gain.value = 0.08;
    noiseNode.connect(gain);
    gain.connect(ac.destination);
    noiseNode.start();
  } else {
    if(noiseNode){ noiseNode.stop(); noiseNode.disconnect(); noiseNode = null; }
  }
}

